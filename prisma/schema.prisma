generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum StatusRegistrasi {
  PENDING
  VALIDATED
  APPROVED
  COMPLETED
}

enum JenisLayanan {
  FOTO_CAP
  CAP_ONLY
}

// ── Admin User ───────────────────────────────────────────────────────────────

model AdminUser {
  id           String  @id @default(cuid())
  username     String  @unique
  email        String  @unique // Email untuk terima OTP
  passwordHash String
  aktif        Boolean @default(true)

  // Email OTP
  otpCode   String? // Hashed OTP
  otpExpiry DateTime? // Berlaku 5 menit

  // Brute force tracking
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Master Data ──────────────────────────────────────────────────────────────

model MasterFakultas {
  id        String        @id @default(cuid())
  nama      String
  kode      String        @unique
  aktif     Boolean       @default(true)
  urutan    Int           @default(0)
  prodi     MasterProdi[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([aktif])
}

model MasterProdi {
  id         String         @id @default(cuid())
  nama       String
  kode       String
  aktif      Boolean        @default(true)
  urutan     Int            @default(0)
  fakultas   MasterFakultas @relation(fields: [fakultasId], references: [id], onDelete: Cascade)
  fakultasId String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([kode, fakultasId])
  @@index([fakultasId])
  @@index([aktif])
}

// ── Registrasi ───────────────────────────────────────────────────────────────

model Registrasi {
  id              String @id @default(cuid())
  nomorRegistrasi String @unique // Format: REG-YYYYMMDD-XXXX

  // Data Mahasiswa
  nama         String
  npm          String
  gmail        String
  fakultas     String // Nama fakultas (dari MasterFakultas.nama)
  programStudi String // Nama prodi (dari MasterProdi.nama)

  // Jadwal yang dipilih user
  tanggalPilihan DateTime
  waktuPilihan   String // "08:00", "09:00", dst

  // Data Layanan (diisi admin saat validasi)
  jenisLayanan JenisLayanan?
  nominal      Int? // 15000 atau 10000 (dalam rupiah)

  // Status & Tracking
  status StatusRegistrasi @default(PENDING)

  // Admin metadata
  catatanAdmin   String?
  divalidasiOleh String?
  divalidasiAt   DateTime?
  disetujuiAt    DateTime?

  // Email kwitansi
  kwitansiTerkirim   Boolean   @default(false)
  kwitansiTerkirimAt DateTime?
  nomorKwitansi      String? // Format: KWT-YYYYMMDD-XXXX

  // Email foto hasil
  fotoHasilTerkirim   Boolean   @default(false)
  fotoHasilTerkirimAt DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([npm])
  @@index([gmail])
  @@index([fakultas])
  @@index([programStudi])
  @@index([tanggalPilihan])
  @@index([createdAt])
}
